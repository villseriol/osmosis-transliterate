<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <pipeline>
        <!-- Ensure our overrides take priority -->
        <run alias="custom">
            <mapping>
                <replace-with value="">
                    <when-value-is value="" />
                    <when-value-is value="" />
                </replace-with>


                <replace-with value="[">
                    <when-value-is value="【" />
                </replace-with>

                <replace-with value="]">
                    <when-value-is value="】" />
                </replace-with>

                <replace-with value=" · ">
                    <when-value-is value="・" />
                    <when-value-is value="･" />
                    <when-value-is value="•" />
                </replace-with>


                <replace-with value="&lt;">
                    <when-value-is value="〈" />
                </replace-with>

                <replace-with value="&lt;&lt;">
                    <when-value-is value="《" />
                </replace-with>

                <replace-with value="&gt;">
                    <when-value-is value="〉" />
                </replace-with>

                <replace-with value="&gt;&gt;">
                    <when-value-is value="》" />
                </replace-with>

                <replace-with value="'">
                    <when-value-is value="ʻ" />
                </replace-with>

                <replace-with value="-">
                    <when-value-is value="–" />
                </replace-with>
            </mapping>
        </run>

        <run alias="small-form" />
        <run alias="general-punctuation" />
        <run alias="arrow" />
        <run alias="box-drawing" />
        <run alias="cyrillic" />
        <run alias="geometric-shapes" />
        <run alias="greek" />
        <run alias="half-width-full-width" />
        <run alias="latin" />
        <run alias="un-accent" />

        <run alias="kakasi">
            <dictionaries>
                <dictionary alias="station" />
                <dictionary alias="geo" />
            </dictionaries>

            <conditional>
                <condition path="classpath:/data/template/v0_6/janino/geo.script.java" />
            </conditional>
        </run>

        <run alias="kakasi">
            <dictionaries>
                <dictionary alias="propernoun" />
                <dictionary alias="fullname" />
                <dictionary alias="jinmei" />
                <dictionary alias="law" />
                <dictionary alias="hukugougo" />
                <dictionary alias="mazegaki" />
            </dictionaries>

            <conditional>
                <condition path="classpath:/data/template/v0_6/janino/general.script.java" />
            </conditional>
        </run>
    </pipeline>

    <filter>
        <!-- Names -->
        <tag key="operator" />
        <tag key="tunnel:name" />
        <tag key="bridge:name" />
        <tag key="name" />
        <tag key="name:en" />
        <tag key="name:ja" />
        <tag key="name:ja-Hira" />
        <tag key="alt_name" />
        <tag key="brand:ja" />
        <tag key="brand" />

        <!-- Addresses -->
        <tag key="ref" />
        <tag key="addr:city" />
        <tag key="addr:province" />
        <tag key="addr:block_number" />
        <tag key="addr:neighbourhood" />
        <tag key="addr:postcode" />
        <tag key="addr:housenumber" />
        <tag key="addr:quarter" />
        <tag key="addr:full" />
        <tag key="addr:suburb" />
        <tag key="addr:country" />
        <tag key="addr:street" />
        <tag key="addr:county" />
        <tag key="addr:housename" />
        <tag key="addr:floor" />
        <tag key="addr:place" />
        <tag key="addr:flats" />
        <tag key="addr:room" />
        <tag key="addr:prefecture" />
        <tag key="addr:unit" />
        <tag key="addr:block" />
        <tag key="addr:district" />
        <tag key="addr:all" />
        <tag key="addr:state" />
        <tag key="addr:pref" />
        <tag key="addr:hamlet" />
        <tag key="addr:region" />
        <tag key="addr:neighborhood" />
        <tag key="addr:subdistrict" />
        <tag key="addr:town" />
    </filter>
</configuration>