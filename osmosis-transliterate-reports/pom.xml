<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.villseriol</groupId>
    <artifactId>osmosis-transliterate-parent</artifactId>
    <version>2.1.0</version>
  </parent>

  <artifactId>osmosis-transliterate-reports</artifactId>
  <packaging>jar</packaging>

  <name>osmosis-transliterate-reports</name>
  <description>Character mapping reports for the osmosis-transliterate plugin.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.villseriol</groupId>
      <artifactId>osmosis-transliterate</artifactId>
    </dependency>

    <!-- osmosis-transliterate declares osmosis-core as provided, which Maven does not pass on to dependents; -->
    <!-- the plugin classes need it at runtime (e.g. OsmosisRuntimeException), so it is declared here -->
    <dependency>
      <groupId>org.openstreetmap.osmosis</groupId>
      <artifactId>osmosis-core</artifactId>
    </dependency>

    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-character-mapping-report-csv</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.github.villseriol.osmosis.reports.GenerateOsmosisTransliterateReport</mainClass>
              <arguments>
                <argument>csv</argument>
                <argument>${maven.multiModuleProjectDirectory}/osmosis-transliterate/src/main/resources/example-oss-hikemap-config.xml</argument>
                <argument>${project.build.directory}/reports/csv</argument>
              </arguments>
            </configuration>
          </execution>

          <execution>
            <id>generate-character-mapping-report-yaml</id>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>io.github.villseriol.osmosis.reports.GenerateOsmosisTransliterateReport</mainClass>
              <arguments>
                <argument>yaml</argument>
                <argument>${maven.multiModuleProjectDirectory}/osmosis-transliterate/src/main/resources/example-oss-hikemap-config.xml</argument>
                <argument>${project.build.directory}/reports/character-mapping-report.yaml</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
